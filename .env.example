# Copia este archivo a .env y ajusta según el entorno.
REDIS_URL=redis://redis:6379
TICK_MS=2000
FANOUT_BATCH=500
STREAM_MAXLEN=1000
SSE_HIGH_WATER=262144
SSE_KILL_WATER=1048576
LOCK_TTL_MS=30000
AUDITOR_IDLE_MS=300000
PRESENCE_TTL_MS=15000
IDEM_TTL_SEC=21600
RL_JUROR=30
RL_PUBLIC=1000
# 1 = habilita /api/debug/flood para la demostración de cliente lento (nunca en producción real)
DEMO_MODE=1
