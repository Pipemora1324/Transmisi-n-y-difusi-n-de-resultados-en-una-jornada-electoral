PORT=3000
HTTP_BIND=127.0.0.1
INSTANCE_ID=local-1
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=
# Cambiar antes de exponer el servicio. JSON: token -> identidad autorizada.
AUDITOR_TOKENS={"sara-local":{"id":"sara","name":"Sara Mideros"},"auditor-local":{"id":"auditor-2","name":"Auditor 2"}}
OPS_TOKEN=ops-local
LOCK_TTL_MS=30000
PRESENCE_TTL_MS=20000
SWEEP_INTERVAL_MS=2000
METRICS_INTERVAL_MS=2000
METRICS_TTL_MS=10000
EXPECTED_INSTANCES=8
AUDITOR_IDLE_MS=300000
# Variables del arranque para las otras ramas (se conservan al integrar).
TICK_MS=2000
FANOUT_BATCH=500
STREAM_MAXLEN=1000
SSE_HIGH_WATER=262144
SSE_KILL_WATER=1048576
IDEM_TTL_SEC=21600
RL_JUROR=30
RL_PUBLIC=1000
DEMO_MODE=0
# Solo para pruebas con startServer sin integration.js; exporta approveHeld(actaId, token).
# APPROVE_MODULE=./src/ingest/actas.js
